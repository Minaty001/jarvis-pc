# === JARVIS PC Configuration ===

# Groq (Normal Conversation - Free)
GROQ_API_KEY=gsk_your_groq_key_here

# NVIDIA NIM (Visualization/Vision - Free)
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# OpenCode Zen (Coding Tasks)
ZEN_API_KEY=your_zen_key_here

# OpenRouter (Fallback - Free Models)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Voice Settings
JARVIS_VOICE=en-US-GuyNeural
JARVIS_WAKE_THRESHOLD=0.8

# Smart Home (Optional)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_hass_token_here
